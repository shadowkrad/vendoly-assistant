{
  "manifest_version": 3,
  "name": "Vendoly Assistant",
  "version": "1.0.3",
  "description": "Assistente di pubblicazione e cross-listing automatico per Vendoly su Vinted e marketplace second-hand.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Vendoly Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://*.vendoly.it/*",
    "*://*.taaaac.eu/*",
    "*://*.vercel.app/*",
    "*://*.vinted.it/*",
    "*://*.vinted.fr/*",
    "*://*.vinted.es/*",
    "*://*.vinted.de/*",
    "*://*.vinted.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.vendoly.it/*",
        "*://*.taaaac.eu/*",
        "*://*.vercel.app/*"
      ],
      "js": ["src/content/vendoly-bridge.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.vinted.it/items/new*",
        "*://*.vinted.fr/items/new*",
        "*://*.vinted.es/items/new*",
        "*://*.vinted.de/items/new*",
        "*://*.vinted.com/items/new*"
      ],
      "js": [
        "src/utils/selectors.js",
        "src/content/vinted-filler.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
